# BidtoList Environment Variables
DFX_NETWORK=local

# Canister IDs (populated by scripts/deploy.sh)
CANISTER_ID_LISTING=
CANISTER_ID_AGENT=
CANISTER_ID_FEE=
CANISTER_ID_FRONTEND=

# ICP Network
ICP_HOST=http://localhost:4943

# Platform fee — cents charged to winning agent per accepted bid (default $295)
PLATFORM_FEE_CENTS=29500

# Agent server — HomeGentic's Cloudflare Workers service hosts all BidtoList routes
# at /api/bidtolist/*. Point this at the HomeGentic Workers deployment in production.
# Add the following via `wrangler secret put <KEY>` or the Cloudflare dashboard
# (Workers & Pages → your worker → Settings → Variables):
#   BIDTOLIST_FRONTEND_ORIGIN=https://bidtolist.com
#   BIDTOLIST_RESEND_API_KEY=re_...
#   BIDTOLIST_RESEND_FROM=noreply@bidtolist.com
#   BIDTOLIST_STRIPE_SECRET_KEY=sk_live_...
#   BIDTOLIST_STRIPE_WEBHOOK_SECRET=whsec_...
#   BIDTOLIST_STRIPE_PRICE_PLATFORM_FEE=price_...
#   BIDTOLIST_LISTING_CANISTER_ID=...
#   BIDTOLIST_AGENT_CANISTER_ID=...
#   BIDTOLIST_FEE_CANISTER_ID=...
#   BIDTOLIST_IDENTITY_SEED=<64-char hex>
#   BIDTOLIST_ICP_HOST=https://ic0.app
VITE_AGENT_SERVER_URL=http://localhost:3001
