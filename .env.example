# BidtoList Environment Variables
DFX_NETWORK=local

# Canister IDs (populated by scripts/deploy.sh)
CANISTER_ID_LISTING=
CANISTER_ID_AGENT=
CANISTER_ID_FEE=
CANISTER_ID_FRONTEND=

# ICP Network
ICP_HOST=http://localhost:4943

# Platform fee — cents charged to winning agent per accepted bid (default $295)
PLATFORM_FEE_CENTS=29500

# Email (Resend — resend.com, free tier: 3,000/month)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@bidtolist.com

# Stripe — one-time payment link sent to agent after bid is won
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID for the $295 platform fee (one-time, mode=payment)
STRIPE_PRICE_PLATFORM_FEE=
