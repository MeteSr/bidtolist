[
  {
    "match": "**/*",
    "headers": {
      "X-Frame-Options": "DENY",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
      "Content-Security-Policy": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://ic0.app https://*.ic0.app https://icp0.io https://*.icp0.io https://homegentic-email-relay.homegentic.workers.dev; frame-src https://identity.ic0.app; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  }
]
